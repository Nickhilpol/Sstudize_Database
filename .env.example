# ==============================================================================
# SStudizer Database Management System - Environment Configuration
# ==============================================================================

# Application Server Settings
PORT=8000
HOST=127.0.0.1
APP_ENV=development
DEBUG=true

# ==============================================================================
# DATABASE CONNECTION SETTINGS
# ==============================================================================
# CURRENT ACTIVE DEFAULT: Local Development SQLite database
# The app works out-of-the-box with complete seeded questions, chapters, and tests!
DATABASE_URL=sqlite:///./backend/sstudizer_dev.db

# ------------------------------------------------------------------------------
# HOW TO CONNECT TO SUPABASE IN THE FUTURE:
# ------------------------------------------------------------------------------
# 1. Comment out the SQLite DATABASE_URL above
# 2. Uncomment ONE of the Supabase PostgreSQL connection strings below:
#
# Option A - Connection Pooler (Recommended for Supabase):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Option B - Direct Database Connection:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require
#
# 3. Optional Supabase REST Client credentials:
# SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
# SUPABASE_ANON_KEY=[YOUR-ANON-PUBLIC-KEY]
# SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]
# ==============================================================================
